/* ============================================================
DATA LOADING
============================================================ */

async function loadEmojiData() {

setLoading(true);

const response = await fetch(CONFIG.dataUrl);

if (!response.ok) {
throw new Error(
`Unable to load emoji data (${response.status})`
);
}

const csvText = await response.text();

const parsed = parseCSV(csvText);

AppState.emojis = parsed
.map(normalizeEmoji)
.filter(Boolean);

console.info(
`[Emoji Encyclopedia] Loaded ${AppState.emojis.length} emojis`
);

setLoading(false);
}

/* ============================================================
CSV PARSER

Handles:

* quoted fields
* commas inside quotes
* CRLF/LF
  ============================================================ */

function parseCSV(text) {

const rows = [];

let row = [];
let value = "";

let insideQuotes = false;

for (let i = 0; i < text.length; i++) {

```
const char = text[i];
const nextChar = text[i + 1];


if (char === '"') {

  if (insideQuotes && nextChar === '"') {

    value += '"';
    i++;

  } else {

    insideQuotes = !insideQuotes;
  }

  continue;
}


if (char === "," && !insideQuotes) {

  row.push(value.trim());
  value = "";

  continue;
}


if (
  (char === "\n" || char === "\r") &&
  !insideQuotes
) {

  if (char === "\r" && nextChar === "\n") {
    i++;
  }

  row.push(value.trim());

  if (
    row.length > 1 ||
    row[0] !== ""
  ) {
    rows.push(row);
  }

  row = [];
  value = "";

  continue;
}


value += char;
```

}

if (value.length || row.length) {

```
row.push(value.trim());
rows.push(row);
```

}

if (!rows.length) {
return [];
}

const headers = rows[0]
.map(header =>
header
.trim()
.toLowerCase()
.replace(/\s+/g, "_")
);

return rows
.slice(1)
.filter(row => row.length)
.map(row => {

```
  const object = {};

  headers.forEach((header, index) => {
    object[header] = row[index] ?? "";
  });

  return object;
});
```

}

/* ============================================================
EMOJI NORMALIZATION

Makes the application flexible enough to support
differently formatted emoji CSV datasets.
============================================================ */

function normalizeEmoji(raw, index) {

if (!raw) return null;

const emoji =
raw.emoji ||
raw.character ||
raw.symbol ||
raw.char ||
raw.native ||
raw.unicode_emoji ||
"";

const name =
raw.name ||
raw.description ||
raw.short_name ||
raw.title ||
raw.label ||
"";

if (!emoji && !name) {
return null;
}

const group =
raw.group ||
raw.category ||
raw.category_name ||
raw.major_group ||
"Other";

const subgroup =
raw.subgroup ||
raw.sub_category ||
raw.subcategory ||
raw.sub_group ||
"Other";

const codepoints =
raw.codepoints ||
raw.codepoint ||
raw.unicode ||
raw.hex ||
emojiToCodepoints(emoji);

const version =
raw.version ||
raw.emoji_version ||
raw.unicode_version ||
"";

const status =
raw.status ||
raw.qualification ||
raw.qualified ||
"";

const keywords = collectKeywords(raw);

const normalizedName = normalizeSearchText(name);

return {

```
id: createEmojiId(
  emoji,
  codepoints,
  index
),

emoji,

name,

normalizedName,

group,

subgroup,

codepoints: normalizeCodepoints(codepoints),

version,

status,

keywords,

raw,

searchIndex: createSearchIndex({
  emoji,
  name,
  group,
  subgroup,
  codepoints,
  keywords,
  version
})
```

};
}

/* ============================================================
SEARCH INDEX
============================================================ */

function createSearchIndex(data) {

return normalizeSearchText(
[
data.emoji,
data.name,
data.group,
data.subgroup,
data.codepoints,
data.version,
...data.keywords
]
.filter(Boolean)
.join(" ")
);
}

function collectKeywords(raw) {

const possibleFields = [

```
"keywords",
"keyword",
"aliases",
"alias",
"tags",
"tag",
"shortcodes",
"shortcode"
```

];

const keywords = [];

possibleFields.forEach(field => {

```
if (!raw[field]) return;


const value = String(raw[field]);


value
  .split(/[|,;]+/)
  .map(item => item.trim())
  .filter(Boolean)
  .forEach(item => keywords.push(item));
```

});

return [...new Set(keywords)];
}

function normalizeSearchText(value) {

return String(value || "")
.toLowerCase()
.normalize("NFKD")
.replace(/[\u0300-\u036f]/g, "")
.replace(/[_-]/g, " ")
.replace(/\s+/g, " ")
.trim();
}

/* ============================================================
CODEPOINT UTILITIES
============================================================ */

function emojiToCodepoints(emoji) {

if (!emoji) return "";

return Array
.from(emoji)
.map(character =>
character
.codePointAt(0)
.toString(16)
.toUpperCase()
)
.join(" ");
}

function normalizeCodepoints(value) {

return String(value || "")
.trim()
.toUpperCase()
.replace(/U+/g, "")
.replace(/0X/g, "")
.replace(/[-_,]/g, " ")
.replace(/\s+/g, " ");
}

function createEmojiId(
emoji,
codepoints,
index
) {

const base =
normalizeCodepoints(codepoints) ||
emojiToCodepoints(emoji) ||
String(index);

return base
.replace(/\s+/g, "-")
.toLowerCase();
}

/* ============================================================
INDEX BUILDING
============================================================ */

function buildIndexes() {

AppState.groups.clear();
AppState.subgroups.clear();

AppState.emojis.forEach(emoji => {

```
if (!AppState.groups.has(emoji.group)) {

  AppState.groups.set(
    emoji.group,
    []
  );
}


AppState.groups
  .get(emoji.group)
  .push(emoji);


const subgroupKey =
  `${emoji.group}|||${emoji.subgroup}`;


if (!AppState.subgroups.has(subgroupKey)) {

  AppState.subgroups.set(
    subgroupKey,
    []
  );
}


AppState.subgroups
  .get(subgroupKey)
  .push(emoji);
```

});
}

