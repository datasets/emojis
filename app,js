if (
AppState.favorites.has(emoji.id)
) {

```
AppState.favorites.delete(emoji.id);
```

} else {

```
AppState.favorites.add(emoji.id);
```

}

saveFavorites();

updateStats();

renderResults();
}

function showFavorites() {

const favorites =
AppState.emojis.filter(emoji =>
AppState.favorites.has(emoji.id)
);

AppState.searchQuery = "";

if (DOM.searchInput) {
DOM.searchInput.value = "";
}

AppState.filteredEmojis =
favorites;

AppState.visibleCount =
CONFIG.initialRenderCount;

updateResultCount(
favorites.length,
"favorites"
);

renderResults();
}

function saveFavorites() {

localStorage.setItem(
CONFIG.storageKeys.favorites,
JSON.stringify(
[...AppState.favorites]
)
);
}

/* ============================================================
RECENT EMOJIS
============================================================ */

function addRecentEmoji(emoji) {

AppState.recent =
AppState.recent.filter(
id => id !== emoji.id
);

AppState.recent.unshift(
emoji.id
);

AppState.recent =
AppState.recent.slice(
0,
CONFIG.maxRecent
);

localStorage.setItem(
CONFIG.storageKeys.recent,
JSON.stringify(AppState.recent)
);
}

/* ============================================================
RANDOM DISCOVERY
============================================================ */

function showRandomEmoji() {

const source =
AppState.filteredEmojis.length
? AppState.filteredEmojis
: AppState.emojis;

if (!source.length) return;

const randomIndex =
Math.floor(
Math.random() * source.length
);

openEmoji(
source[randomIndex]
);
}

/* ============================================================
CLIPBOARD
============================================================ */

async function copyEmojiToClipboard(emoji) {

await copyText(
emoji.emoji,
`${emoji.emoji} copied!`
);
}

async function copyText(
value,
message = "Copied!"
) {

try {

```
await navigator.clipboard.writeText(value);

showToast(message);
```

} catch (error) {

```
console.warn(
  "Clipboard API unavailable:",
  error
);


fallbackCopy(value);

showToast(message);
```

}
}

function fallbackCopy(value) {

const textarea =
document.createElement("textarea");

textarea.value = value;

textarea.style.position = "fixed";

textarea.style.opacity = "0";

document.body.appendChild(textarea);

textarea.select();

document.execCommand("copy");

textarea.remove();
}

/* ============================================================
URL ROUTING
============================================================ */

function processRoute() {

const hash =
window.location.hash;

if (!hash) return;

const match =
hash.match(/^#emoji=(.+)$/);

if (!match) return;

const id =
decodeURIComponent(match[1]);

const emoji =
AppState.emojis.find(
item => item.id === id
);

if (emoji) {

```
setTimeout(() => {
  openEmojiFromRoute(emoji);
}, 0);
```

}
}

function openEmojiFromRoute(emoji) {

AppState.selectedEmoji = emoji;

addRecentEmoji(emoji);

if (!DOM.modal) return;

DOM.modal.hidden = false;

document.body.classList.add(
"modal-open"
);

renderEmojiModal(emoji);
}

function updateURL(emojiId = null) {

if (emojiId) {

```
const hash =
  `#emoji=${encodeURIComponent(emojiId)}`;


if (
  window.location.hash !== hash
) {

  history.replaceState(
    null,
    "",
    hash
  );
}

return;
```

}

if (
AppState.searchQuery
) {

```
const params =
  new URLSearchParams();

params.set(
  "q",
  AppState.searchQuery
);


history.replaceState(
  null,
  "",
  `${window.location.pathname}?${params.toString()}`
);
```

}
}

/* ============================================================
KEYBOARD CONTROLS
============================================================ */

function handleKeyboard(event) {

if (
event.key === "/" &&
!isTypingTarget(event.target)
) {

```
event.preventDefault();

DOM.searchInput?.focus();

return;
```

}

if (
event.key === "Escape"
) {

```
if (
  AppState.selectedEmoji
) {

  closeModal();

} else {

  clearSearch();
}
```

}

if (
event.key === "Enter" &&
event.ctrlKey
) {

```
showRandomEmoji();
```

}
}

function isTypingTarget(element) {

if (!element) return false;

const tag =
element.tagName?.toLowerCase();

return (
tag === "input" ||
tag === "textarea" ||
element.isContentEditable
);
}

