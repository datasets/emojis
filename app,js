THEME
============================================================ */

function updateTheme() {

const savedTheme =
localStorage.getItem(
CONFIG.storageKeys.theme
);

if (!savedTheme) return;

document.documentElement.dataset.theme =
savedTheme;
}

/* ============================================================
DEBOUNCE
============================================================ */

function debounce(
callback,
delay
) {

let timeout;

return (...args) => {

```
clearTimeout(timeout);


timeout =
  setTimeout(
    () => callback(...args),
    delay
  );
```

};
}

