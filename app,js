function searchEmoji(
emoji,
query
) {

if (!query) {
return {
match: true,
score: 0
};
}

const normalizedQuery =
normalizeSearchText(query);

const terms =
normalizedQuery
.split(/\s+/)
.filter(Boolean);

let score = 0;

for (const term of terms) {

```
const termUpper =
  term.toUpperCase();


if (
  emoji.emoji === query ||
  emoji.emoji.includes(query)
) {

  score += 1000;
  continue;
}


if (
  emoji.codepoints.includes(termUpper)
) {

  score += 900;
  continue;
}


if (
  emoji.normalizedName === term
) {

  score += 800;
  continue;
}


if (
  emoji.normalizedName.startsWith(term)
) {

  score += 700;
  continue;
}


if (
  emoji.normalizedName.includes(term)
) {

  score += 600;
  continue;
}


if (
  emoji.keywords.some(keyword =>
    normalizeSearchText(keyword)
      .includes(term)
  )
) {

  score += 500;
  continue;
}


if (
  emoji.group &&
  normalizeSearchText(emoji.group)
    .includes(term)
) {

  score += 200;
  continue;
}


if (
  emoji.subgroup &&
  normalizeSearchText(emoji.subgroup)
    .includes(term)
) {

  score += 150;
  continue;
}


if (
  emoji.searchIndex.includes(term)
) {

  score += 50;
  continue;
}


return {
  match: false,
  score: 0
};
```

}

return {
match: true,
score
};
}

/* ============================================================
FILTERING
============================================================ */

function applyFilters() {

const results = [];

for (const emoji of AppState.emojis) {

```
if (
  AppState.activeGroup !== "all" &&
  emoji.group !== AppState.activeGroup
) {
  continue;
}


if (
  AppState.activeSubgroup !== "all" &&
  emoji.subgroup !== AppState.activeSubgroup
) {
  continue;
}


const search =
  searchEmoji(
    emoji,
    AppState.searchQuery
  );


if (!search.match) {
  continue;
}


results.push({
  emoji,
  score: search.score
});
```

}

AppState.filteredEmojis =
sortResults(results)
.map(item => item.emoji);

AppState.visibleCount =
Math.min(
AppState.visibleCount,
Math.max(
CONFIG.initialRenderCount,
AppState.filteredEmojis.length
)
);
}

function sortResults(results) {

const mode =
AppState.sortMode;

return results.sort((a, b) => {

```
const emojiA = a.emoji;
const emojiB = b.emoji;


if (mode === "name-asc") {

  return emojiA.name.localeCompare(
    emojiB.name
  );

}


if (mode === "name-desc") {

  return emojiB.name.localeCompare(
    emojiA.name
  );

}


if (mode === "unicode") {

  return emojiA.codepoints.localeCompare(
    emojiB.codepoints
  );

}


if (mode === "favorites") {

  const aFavorite =
    AppState.favorites.has(emojiA.id);

  const bFavorite =
    AppState.favorites.has(emojiB.id);


  if (aFavorite !== bFavorite) {

    return aFavorite ? -1 : 1;
  }


  return emojiA.name.localeCompare(
    emojiB.name
  );
}


return (
  b.score - a.score ||
  emojiA.name.localeCompare(emojiB.name)
);
```

});
}

