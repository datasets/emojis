    AppState.activeGroup === group,
    () => {

      AppState.activeGroup = group;
      AppState.activeSubgroup = "all";

      resetVisibleResults();

    }
  )
);
```

});
}

function renderSubgroupFilters() {

if (!DOM.subgroupFilters) return;

DOM.subgroupFilters.innerHTML = "";

if (
AppState.activeGroup === "all"
) {
return;
}

const subgroups =
[];

for (
const [key, emojis]
of AppState.subgroups.entries()
) {

```
const [group, subgroup] =
  key.split("|||");


if (
  group === AppState.activeGroup
) {

  subgroups.push({
    subgroup,
    count: emojis.length
  });
}
```

}

if (!subgroups.length) {
return;
}

DOM.subgroupFilters.appendChild(
createFilterButton(
"all",
"All",
subgroups.reduce(
(total, item) =>
total + item.count,
0
),
AppState.activeSubgroup === "all",
() => {

```
    AppState.activeSubgroup = "all";

    resetVisibleResults();

  }
)
```

);

subgroups.forEach(item => {

```
DOM.subgroupFilters.appendChild(
  createFilterButton(
    item.subgroup,
    item.subgroup,
    item.count,
    AppState.activeSubgroup === item.subgroup,
    () => {

      AppState.activeSubgroup =
        item.subgroup;

      resetVisibleResults();

    }
  )
);
```

});
}

function createFilterButton(
value,
label,
count,
active,
onClick
) {

const button =
document.createElement("button");

button.type = "button";

button.className =
`filter-button${active ? " active" : ""}`;

button.dataset.value = value;

const text =
document.createElement("span");

text.textContent = label;

const badge =
document.createElement("span");

badge.className = "filter-count";

badge.textContent = count;

button.append(
text,
badge
);

button.addEventListener(
"click",
onClick
);

return button;
}

/* ============================================================
RESULTS RENDERING
============================================================ */

function renderResults() {

if (!DOM.emojiGrid) return;

const total =
AppState.filteredEmojis.length;

updateResultCount(total);

if (!total) {

```
DOM.emojiGrid.innerHTML = "";

showEmptyState(true);

toggleLoadMore(false);

return;
```

}

showEmptyState(false);

const visible =
AppState.filteredEmojis.slice(
0,
AppState.visibleCount
);

const fragment =
document.createDocumentFragment();

visible.forEach(emoji => {

```
fragment.appendChild(
  createEmojiCard(emoji)
);
```

});

DOM.emojiGrid.innerHTML = "";

DOM.emojiGrid.appendChild(fragment);

toggleLoadMore(
AppState.visibleCount < total
);
}

